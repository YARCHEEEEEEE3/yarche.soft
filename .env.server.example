# Server-only. Copy to .env.server, never commit real values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FISH_KEY_ENCRYPTION_KEY=
# Persistent disk, outside the public frontend folder; keep backed up with the encryption key.
FISH_KEY_STORE=.data/fish-keys
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yarcheeeeeee3.github.io
HOST=127.0.0.1
PORT=8787
